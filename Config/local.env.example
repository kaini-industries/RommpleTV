# Copy to Config/local.env and fill in. That file is gitignored and must stay
# that way — it names your server and your hardware.
#
# Everything here is read by scripts/gen-local-config.sh and scripts/deploy.sh.
# Both scripts work with this file absent; you just get the public defaults and
# have to configure the app on-screen instead.

# Base URL of your RomM server, no trailing slash.
ROMM_BASE_URL=http://romm.example:8090

# udid of the Apple TV to deploy to. Find it with:
#   xcrun devicectl list devices
APPLE_TV_DEVICE_ID=00000000-0000-0000-0000-000000000000
